# Copy this file to .env and fill in your own values. Never commit .env itself.

PORT=5000

# Get this free from https://www.mongodb.com/cloud/atlas (M0 free cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tourism-app

# Any long random string - used to sign JWTs
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used only by seed/seedAdmin.js to create your first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
